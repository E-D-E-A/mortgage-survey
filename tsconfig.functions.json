{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // בדיקות האינטגרציה מייבאות את קבצי ה-.mts של הפונקציות ישירות
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["netlify/functions", "tests"]
}
