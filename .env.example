# ── סודות שרת ─────────────────────────────────────────────────────────
# נקראים ע"י ה-Netlify Functions בלבד, לעולם לא מגיעים לדפדפן.
# אסור בשום מצב לתת להם קידומת ‎VITE_‎ (קידומת כזו מכניסה אותם לבאנדל הציבורי!).
# מקומית: הקובץ הזה משמש את ‎netlify dev / netlify serve‎.
# בפרודקשן: netlify env:set (ראו README).
# מקור הערכים: Supabase → Project Settings → API (המפתח: service_role).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── מפתחות ציבוריים (לדפדפן) ──────────────────────────────────────────
# ה-anon key הוא מפתח ציבורי בהגדרתו, ולכן ‎VITE_‎ כאן תקין ומכוון: הוא
# משמש את קונסולת הניהול לדיבור עם Supabase Auth בלבד. הוא לא מקנה גישה
# לנתונים — RLS חוסם את anon לגמרי (אפס policies), וההרשאה לעריכה נאכפת
# בשרת (netlify/functions/lib/session.ts) ולא בדפדפן.
# אותו URL כמו SUPABASE_URL למעלה.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── אופציונלי: כניסת Google מול הסטאק המקומי ─────────────────────────
# נקראים ע"י supabase/config.toml (env()) בהרצת ‎npx supabase start‎ בלבד —
# לא חלק מהפריסה. הערכים: אותם Client ID/Secret שבדשבורד Supabase.
# דורש גם רישום ‎http://127.0.0.1:54321/auth/v1/callback‎ ב-Google Console.
# בלי זה: npm run dev:login (ראו README, "דאטהבייס מקומי").
# SUPABASE_AUTH_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_GOOGLE_SECRET=
