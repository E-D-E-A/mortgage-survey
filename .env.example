# משתני שרת בלבד — נקראים ע"י ה-Netlify Functions, לעולם לא מגיעים לדפדפן.
# אסור בשום מצב לתת להם קידומת ‎VITE_‎ (קידומת כזו מכניסה אותם לבאנדל הציבורי!).
# מקומית: הקובץ הזה משמש את ‎netlify dev / netlify serve‎.
# בפרודקשן: netlify env:set (ראו README).
# מקור הערכים: Supabase → Project Settings → API (המפתח: service_role, לא anon).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# אימות קונסולת הניהול (/admin):
# GOOGLE_CLIENT_ID — ה-OAuth Client ID מ-Google Cloud Console (אותו ערך בשניהם).
# ADMIN_SESSION_SECRET — מחרוזת אקראית ≥32 בייטים לחתימת עוגיית הסשן:
#   openssl rand -base64 32
GOOGLE_CLIENT_ID=
ADMIN_SESSION_SECRET=

# חריג מכוון לכלל ה-VITE_: מזהה OAuth Client הוא ציבורי בהגדרתו (מופיע בכל
# בקשת OAuth) — אין כאן סוד. חייב להיות זהה ל-GOOGLE_CLIENT_ID שלמעלה.
VITE_GOOGLE_CLIENT_ID=
